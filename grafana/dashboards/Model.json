      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "PSI tenure",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "pg"
                      },
                      "spec": {
                        "dataset": "churnapp",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH params AS (\r\n    SELECT 'tenure'::text AS feature\r\n),\r\nbounds AS (\r\n    SELECT min(day) + INTERVAL '20 days' AS ramp_start FROM drift_metrics\r\n),\r\nthreshold AS (\r\n    SELECT\r\n        percentile_disc(0.50) WITHIN GROUP (ORDER BY d.psi)\r\n          + 3 * (percentile_disc(0.95) WITHIN GROUP (ORDER BY d.psi)\r\n               - percentile_disc(0.50) WITHIN GROUP (ORDER BY d.psi)) AS alert_at\r\n    FROM drift_metrics d, bounds b, params p\r\n    WHERE d.window_days = 7\r\n      AND d.feature = p.feature\r\n      AND d.day < b.ramp_start\r\n)\r\nSELECT d.day::timestamp AS time,\r\n       d.psi            AS psi,\r\n       t.alert_at       AS threshold\r\nFROM drift_metrics d, threshold t, params p\r\nWHERE d.window_days = 7\r\n  AND d.feature = p.feature\r\nORDER BY 1;\r\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
