      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Precision / recall per week",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "pg"
                      },
                      "spec": {
                        "dataset": "churnapp",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH as_of AS (\r\n    SELECT (SELECT max(event_time) FROM predictions) + INTERVAL '45 days' AS t\r\n),\r\nscored AS (\r\n    SELECT\r\n        date_trunc('week', p.event_time) AS time,\r\n        p.prediction,\r\n        l.label,\r\n        (l.available_at <= (SELECT t FROM as_of)) AS revealed\r\n    FROM predictions p\r\n    JOIN labels l ON l.request_id = p.request_id\r\n)\r\nSELECT\r\n    time,\r\n    count(*) FILTER (WHERE revealed AND prediction = 'churn' AND label = 1)::numeric\r\n      / nullif(count(*) FILTER (WHERE revealed AND prediction = 'churn'), 0) AS precision,\r\n    count(*) FILTER (WHERE revealed AND prediction = 'churn' AND label = 1)::numeric\r\n      / nullif(count(*) FILTER (WHERE revealed AND label = 1), 0)            AS recall,\r\n    count(*) FILTER (WHERE revealed)::numeric / count(*)                     AS coverage\r\nFROM scored\r\nGROUP BY time\r\nORDER BY time;\r\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
